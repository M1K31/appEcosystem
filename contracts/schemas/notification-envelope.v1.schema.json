{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartindustries.dev/schemas/appecosystem/notification-envelope.v1.schema.json",
  "title": "EcosystemNotificationEnvelopeV1",
  "description": "Deduplicated, privacy-redacted cross-device notification envelope.",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "dedupe_key",
    "source",
    "severity",
    "title",
    "body",
    "actions",
    "privacy",
    "ttl",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "pattern": "^notify\\.[a-z][a-z0-9_]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": ["app", "device_id"],
      "additionalProperties": false,
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1
        },
        "device_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": ["string", "null"]
          },
          "requires": {
            "type": "string",
            "enum": ["none", "freeze_grant", "approver_auth", "policy_admin"]
          }
        }
      }
    },
    "privacy": {
      "type": "string",
      "enum": ["redacted", "public", "local_only"]
    },
    "ttl": {
      "type": "string",
      "pattern": "^[0-9]+(s|m|h|d)$"
    },
    "deep_link": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": "string",
      "minLength": 10
    },
    "signature": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
