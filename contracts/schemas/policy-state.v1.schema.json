{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartindustries.dev/schemas/appecosystem/policy-state.v1.schema.json",
  "title": "EcosystemPolicyStateV1",
  "description": "Effective policy, restriction override, and freeze state rendered by <ecosystem-policy-bar> across all dashboards.",
  "type": "object",
  "required": [
    "schema_version",
    "policy_version",
    "mode",
    "restrictions",
    "frozen",
    "always_enforced",
    "authority",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "type": "string",
      "enum": ["normal", "incident", "survival", "freeze", "maintenance"]
    },
    "restrictions": {
      "type": "string",
      "enum": ["on", "off_scoped"]
    },
    "frozen": {
      "type": "boolean"
    },
    "freeze_confirmed": {
      "type": "boolean",
      "description": "Optional. Emitted as false only by a surface that froze itself locally and could not confirm delivery to the mesh; hub-originated state omits it. Renderers show such a freeze as local-only and keep Freeze available as a retry."
    },
    "freeze_durable": {
      "type": "boolean",
      "description": "Optional. Emitted as false only by a surface whose local freeze could not be written to disk and would be lost on restart."
    },
    "freeze_info": {
      "type": ["object", "null"],
      "required": ["initiated_by", "reason", "since"],
      "additionalProperties": false,
      "properties": {
        "initiated_by": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": ["string", "null"]
        },
        "reason": {
          "type": "string"
        },
        "since": {
          "type": "string",
          "minLength": 10
        },
        "acknowledged_devices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pending_devices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unreachable_devices": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "active_override": {
      "type": ["object", "null"],
      "required": [
        "grant_id",
        "issued_by",
        "reason",
        "scope",
        "bypassed",
        "issued_at"
      ],
      "additionalProperties": false,
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1
        },
        "issued_by": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "required": ["apps", "devices", "action_classes"],
          "additionalProperties": false,
          "properties": {
            "apps": {
              "type": "array",
              "items": { "type": "string" }
            },
            "devices": {
              "type": "array",
              "items": { "type": "string" }
            },
            "action_classes": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "bypassed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "issued_at": {
          "type": "string",
          "minLength": 10
        },
        "expires_at": {
          "type": ["string", "null"]
        },
        "applied_devices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pending_devices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unreachable_devices": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "always_enforced": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "authority": {
      "type": "string",
      "enum": ["hub_synced", "standalone_local", "lease_expired"]
    },
    "updated_at": {
      "type": "string",
      "minLength": 10
    }
  }
}
