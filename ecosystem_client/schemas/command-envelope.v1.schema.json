{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartindustries.dev/schemas/appecosystem/command-envelope.v1.schema.json",
  "title": "EcosystemCommandEnvelopeV1",
  "description": "Authenticated, replay-resistant command envelope with actor identity, target scope, expiry, idempotency, and authorization reference.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "command",
    "action_class",
    "actor",
    "target",
    "parameters",
    "issued_at",
    "expires_at",
    "correlation_id",
    "idempotency_key",
    "ack_required",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "command": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "action_class": {
      "type": "string",
      "enum": [
        "observe",
        "investigate",
        "contain",
        "remediate",
        "data_release",
        "system_change"
      ]
    },
    "actor": {
      "type": "object",
      "required": ["id", "type", "app", "device_id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "operator",
            "service",
            "automation",
            "voice_intent",
            "ai_proposal"
          ]
        },
        "app": {
          "type": "string",
          "minLength": 1
        },
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "auth_method": {
          "type": ["string", "null"]
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["scope"],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["local", "device", "group", "ecosystem", "external"]
        },
        "device_id": {
          "type": ["string", "null"]
        },
        "service": {
          "type": ["string", "null"]
        },
        "identifier": {
          "type": ["string", "null"]
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "issued_at": {
      "type": "number",
      "minimum": 0
    },
    "expires_at": {
      "type": "number",
      "minimum": 0
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "authorization_ref": {
      "type": ["string", "null"],
      "description": "Signed policy override, approval ID, or device grant reference (never a notification ID)."
    },
    "rationale": {
      "type": ["string", "null"]
    },
    "ack_required": {
      "type": "boolean"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
